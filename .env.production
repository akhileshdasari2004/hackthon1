# ─────────────────────────────────────────────────────────────────────────────
# Agira Backend — Production Environment Variables
# Copy this to .env on the server: cp .env.production .env
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED — generate with: openssl rand -hex 32
API_KEY=your-super-secret-api-key-here

# ── Paths (must be writable) ─────────────────────────────────────────────────
AGIRA_PROJECT_ROOT=/app
AGIRA_JOBS_DIR=/data/jobs
AGIRA_MEMORY_PATH=/data/memory_store.json
AGIRA_SETTINGS_PATH=/data/settings.json
AGIRA_MEMORY_DIR=/data

# Python binary
PYTHON_BIN=python3

# ── GitHub Integration (optional) ────────────────────────────────────────────
# Personal access token for creating PRs from the repair workflow.
# Generate at: https://github.com/settings/tokens
# Required scopes: repo (for private repos), public_repo (for public)
GH_TOKEN=

# ── Execution Limits ─────────────────────────────────────────────────────────
# Maximum time a single job can run (seconds)
AGIRA_JOB_TIMEOUT=600

# Maximum number of concurrent jobs
AGIRA_MAX_CONCURRENT_JOBS=4

# Sandbox execution mode: "subprocess" (default/dev) or "docker" (production)
AGIRA_SANDBOX_MODE=docker

# Docker image for sandbox (must be agira/sandbox:*)
AGIRA_SANDBOX_IMAGE=ghcr.io/akhileshdasari2004/hackthon1/sandbox:latest

# ── Logging ──────────────────────────────────────────────────────────────────
# Set to "debug" only if needed — very verbose
AGIRA_LOG_MODE=production

# ── Memory & Learning ────────────────────────────────────────────────────────
# Persist learnings across restarts (recommended: yes in production)
AGIRA_MEMORY_PERSIST=1

# ── Self-Healing ─────────────────────────────────────────────────────────────
AGIRA_SELF_HEALING=true
AGIRA_MAX_RETRIES=2

# ── Telemetry (optional) ─────────────────────────────────────────────────────
# Sentry DSN for error tracking: https://sentry.io
SENTRY_DSN=